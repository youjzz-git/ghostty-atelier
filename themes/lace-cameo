# Lace · Cameo (蕾丝 · 浮雕框)
# Midnight-navy lace over the whole pane with an oval cameo window framed in
# Chantilly lace. In a full-screen window the cameo sits over the upper right of the
# desktop. Set background-opacity = 0.5 in your config.
background-image = ~/.config/ghostty/backgrounds/lace-cameo.png
background-image-fit = cover
background-image-position = center
background-image-opacity = 1.9
