# Glass · Rain on the pane (雨窗)
# A window on a rainy night: condensation on the glass, drops and the trails they
# leave wiping it clear. Set background-opacity = 0.5 in your config.
background-image = ~/.config/ghostty/backgrounds/glass-rain.png
background-image-fit = cover
background-image-position = center
background-image-opacity = 1.9
