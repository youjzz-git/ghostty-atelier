# Muse · Mondrian (缪斯 · 蒙德里安)
# "Broadway Boogie Woogie" after dark: mustard lines broken into oxblood, navy and slate squares,
# colour blocks, and one open cell where the figure stands, the head breaking through the grid.
# The cut-out follows a figure in one particular wallpaper, placed for a full-screen window. Set background-opacity = 0.5 in your config.
background-image = ~/.config/ghostty/backgrounds/muse-mondrian.png
background-image-fit = cover
background-image-position = center
background-image-opacity = 1.9
background = #0d0e12
foreground = #f4f2ec
cursor-color = #f6c835
cursor-text = #0d0e12
selection-background = #353d4d
selection-foreground = #f4f2ec
split-divider-color = #3d3e43

