# Muse · Klimt (缪斯 · 克里姆特)
# After "Portrait of Adele Bloch-Bauer I": face, hair and shoulders stay open, the rest of the figure
# turns into a gown of gold leaf in wavy panels of eyes, spirals and rectangles, in a field of gold mosaic.
# The cut-out follows a figure in one particular wallpaper, placed for a full-screen window. Set background-opacity = 0.5 in your config.
background-image = ~/.config/ghostty/backgrounds/muse-klimt.png
background-image-fit = cover
background-image-position = center
background-image-opacity = 1.9
